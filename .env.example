# -----------------------------------------------------------------------------
# AvisTrack — variables d'environnement
# Copier ce fichier vers `.env.local` puis renseigner les valeurs.
# `.env.local` n'est jamais versionné.
# -----------------------------------------------------------------------------

# --- Supabase (obligatoire) --------------------------------------------------
# Tableau de bord Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clé `service_role` : accès administrateur, contourne les politiques RLS.
# NE JAMAIS exposer côté navigateur (pas de préfixe NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Identifiant du projet Supabase (xxx dans l'URL ci-dessus).
# Utilisé uniquement par `npm run update-types` (CLI, côté serveur).
SUPABASE_PROJECT_ID=xxxxxxxxxxxx

# --- Application -------------------------------------------------------------
# URL publique canonique : sert au QR code, au sitemap et aux redirections OAuth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google OAuth (Supabase local) -------------------------------------------
# Tableau de bord Supabase → Authentication → Providers → Google
GOOGLE_CLIENT_ID=TON_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TON_GOOGLE_CLIENT_SECRET
